---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft && post.data.lang === 'zh');
  return posts.map((post) => ({ params: { slug: post.data.path }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} locale="zh">
  <Content />
</PostLayout>
