---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found / 页面没有找到" description="The requested page could not be found.">
  <section class="not-found">
    <span>404</span>
    <h1>Signal lost.<br /><em>页面走丢了。</em></h1>
    <p>The route may have moved. 这个链接可能已经改变。</p>
    <a href="/">Back home / 返回首页 →</a>
  </section>
</BaseLayout>
