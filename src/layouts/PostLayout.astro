---
import type { BlogPost } from '../utils/posts';
import type { Locale } from '../consts';
import { formatDate, readingTime } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';
import PostComments from '../components/PostComments.astro';

interface Props {
  post: BlogPost;
  locale: Locale;
}

const { post, locale } = Astro.props;
const prefix = locale === 'zh' ? '/zh' : '';
const commentsEnabled = Boolean(import.meta.env.PUBLIC_WALINE_SERVER_URL?.trim());
const copy = locale === 'zh'
  ? { back: '返回全部文章', published: '发布于', updated: '更新于', minutes: '分钟阅读', tags: '文章标签', end: '完', note: commentsEnabled ? '如果它让你想到什么，欢迎在下方留言。' : '如果它让你想到什么，欢迎从 GitHub 开始交流。', more: '继续阅读' }
  : { back: 'Back to all writing', published: 'Published', updated: 'Updated', minutes: 'min read', tags: 'Filed under', end: 'END', note: commentsEnabled ? 'If this sparked a thought, share it in the comments below.' : 'If this sparked a thought, start a conversation on GitHub.', more: 'Keep reading' };
---

<BaseLayout
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  type="article"
  alternatePath={`${locale === 'en' ? '/zh' : ''}/writing/${post.data.path}/`}
>
  <article class="article-page">
    <header class="article-header">
      <a class="eyebrow back-link" href={`${prefix}/writing/`}>← {copy.back}</a>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <div class="article-byline">
        <div>
          <span>{copy.published} {formatDate(post.data.publishedAt, locale)}</span>
          {post.data.updatedAt && <span>{copy.updated} {formatDate(post.data.updatedAt, locale)}</span>}
        </div>
        <span>{readingTime(post.body)} {copy.minutes}</span>
      </div>
    </header>

    <div class="article-grid">
      <aside class="article-aside">
        <span class="aside-label">{copy.tags}</span>
        <ul class="tag-list article-tag-list vertical">
          {post.data.tags.map((tag) => <li><wa-tag size="s" appearance="filled-outlined" variant="neutral">{tag}</wa-tag></li>)}
        </ul>
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>

    <footer class="article-end">
      <span>{copy.end}</span>
      <p>{copy.note}</p>
      <a href={`${prefix}/writing/`}>{copy.more} →</a>
    </footer>
  </article>
  <PostComments locale={locale} articleKey={post.data.translationKey} />
</BaseLayout>
