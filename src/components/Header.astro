---
import type { Locale } from '../consts';

interface Props {
  locale?: Locale;
  alternateHref?: string;
}

const { locale = 'en', alternateHref = locale === 'en' ? '/zh/' : '/' } = Astro.props;
const currentPath = Astro.url.pathname;
const copy = locale === 'zh'
  ? { home: '首页', work: '项目', writing: '文章', profile: '履历', theme: '切换明暗主题', language: 'EN' }
  : { home: 'Home', work: 'Work', writing: 'Writing', profile: 'Profile', theme: 'Toggle color theme', language: '中文' };
const prefix = locale === 'zh' ? '/zh' : '';
const nav = [
  { href: `${prefix}/`, label: copy.home },
  { href: `${prefix}/projects/`, label: copy.work },
  { href: `${prefix}/writing/`, label: copy.writing },
  { href: `${prefix}/#profile`, label: copy.profile },
];
const isCurrent = (href: string) => currentPath === href
  || (href.includes('/writing/') && currentPath.startsWith(href))
  || (href.includes('/projects/') && currentPath.startsWith(href));
---

<header class="site-header">
  <a class="wordmark" href={`${prefix}/`} aria-label="小木同学 Builds">
    <img src="/avatar-leon.png" width="34" height="34" alt="" />
    <span class="wordmark-hanzi">小木同学</span>
    <span class="wordmark-builds">BUILDS</span>
  </a>

  <nav class="desktop-nav" aria-label={locale === 'zh' ? '主导航' : 'Main navigation'}>
    {nav.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="header-tools">
    <a class="language-switch" href={alternateHref} hreflang={locale === 'en' ? 'zh-CN' : 'en'}>{copy.language}</a>
    <button class="theme-toggle" type="button" aria-label={copy.theme} title={copy.theme} aria-pressed="false">
      <span class="sun" aria-hidden="true">☀</span>
      <span class="moon" aria-hidden="true">◐</span>
    </button>
  </div>
</header>

<div class="mobile-navigation">
  <nav class="mobile-nav-panel" id="mobile-nav-panel" aria-label={locale === 'zh' ? '移动端导航' : 'Mobile navigation'} hidden>
    {nav.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}<span aria-hidden="true">↗</span></a>
    ))}
  </nav>
  <button
    class="mobile-nav-trigger"
    type="button"
    aria-controls="mobile-nav-panel"
    aria-expanded="false"
    aria-label={locale === 'zh' ? '打开导航菜单' : 'Open navigation menu'}
  >
    <span>小木同学</span><span class="mobile-nav-icon" aria-hidden="true">☰</span>
  </button>
</div>

<script is:inline>
  const button = document.querySelector('.theme-toggle');
  button?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    button.setAttribute('aria-pressed', String(next === 'dark'));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#141c22' : '#f9faf9');
    localStorage.setItem('theme', next);
  });

  const menu = document.querySelector('.mobile-navigation');
  const trigger = menu?.querySelector('.mobile-nav-trigger');
  const panel = menu?.querySelector('.mobile-nav-panel');
  const closeMenu = () => {
    if (!trigger || !panel) return;
    panel.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-label', trigger.dataset.openLabel);
  };
  if (trigger && panel) {
    trigger.dataset.openLabel = trigger.getAttribute('aria-label');
    trigger.addEventListener('click', () => {
      const opening = panel.hidden;
      panel.hidden = !opening;
      trigger.setAttribute('aria-expanded', String(opening));
      trigger.setAttribute('aria-label', opening
        ? (document.documentElement.lang === 'zh-CN' ? '关闭导航菜单' : 'Close navigation menu')
        : trigger.dataset.openLabel);
      if (opening) panel.querySelector('a')?.focus();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        closeMenu();
        trigger.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!panel.hidden && !menu.contains(event.target)) closeMenu();
    });
  }
</script>
