---
import type { Locale } from '../consts';

interface Props {
  locale?: Locale;
  alternateHref?: string;
}

const { locale = 'en', alternateHref = locale === 'en' ? '/zh/' : '/' } = Astro.props;
const currentPath = Astro.url.pathname;
const copy = locale === 'zh'
  ? { home: '首页', work: '项目', writing: '文章', profile: '履历', theme: '切换明暗主题', language: 'EN', menu: '菜单', navigation: '站点导航' }
  : { home: 'Home', work: 'Work', writing: 'Writing', profile: 'Profile', theme: 'Toggle color theme', language: '中文', menu: 'Menu', navigation: 'Site navigation' };
const prefix = locale === 'zh' ? '/zh' : '';
const nav = [
  { href: `${prefix}/`, label: copy.home },
  { href: `${prefix}/projects/`, label: copy.work },
  { href: `${prefix}/writing/`, label: copy.writing },
  { href: `${prefix}/#profile`, label: copy.profile },
];
const isCurrent = (href: string) => currentPath === href
  || (href.includes('/writing/') && currentPath.startsWith(href))
  || (href.includes('/projects/') && currentPath.startsWith(href));
---

<header class="site-header">
  <a class="wordmark" href={`${prefix}/`} aria-label="小木同学 Builds">
    <img src="/avatar-leon.png" width="34" height="34" alt="" />
    <span class="wordmark-hanzi">小木同学</span>
    <span class="wordmark-builds">BUILDS</span>
  </a>

  <nav class="desktop-nav" aria-label={locale === 'zh' ? '主导航' : 'Main navigation'}>
    {nav.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="header-tools">
    <a class="language-switch" href={alternateHref} hreflang={locale === 'en' ? 'zh-CN' : 'en'}>{copy.language}</a>
    <button class="theme-toggle" type="button" aria-label={copy.theme} title={copy.theme} aria-pressed="false">
      <span class="sun" aria-hidden="true">☀</span>
      <span class="moon" aria-hidden="true">◐</span>
    </button>
  </div>
</header>

<div class="mobile-navigation">
  <wa-button class="mobile-nav-trigger" appearance="filled-outlined" aria-controls="mobile-nav-drawer" aria-expanded="false">
    <span>小木同学</span><span class="mobile-menu-label"><span aria-hidden="true">☰</span>{copy.menu}</span>
  </wa-button>
</div>
<wa-drawer class="mobile-nav-drawer" id="mobile-nav-drawer" placement="bottom" label={copy.navigation} light-dismiss>
  <nav class="mobile-drawer-links" aria-label={copy.navigation}>
    {nav.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}<span aria-hidden="true">↗</span></a>
    ))}
  </nav>
</wa-drawer>

<script is:inline>
  const button = document.querySelector('.theme-toggle');
  button?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    document.documentElement.classList.toggle('wa-dark', next === 'dark');
    document.documentElement.classList.toggle('wa-light', next === 'light');
    button.setAttribute('aria-pressed', String(next === 'dark'));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#141c22' : '#f9faf9');
    localStorage.setItem('theme', next);
  });

  const trigger = document.querySelector('.mobile-nav-trigger');
  const drawer = document.querySelector('.mobile-nav-drawer');
  if (trigger && drawer) {
    trigger.addEventListener('click', async () => {
      await customElements.whenDefined('wa-drawer');
      drawer.open = true;
    });
    drawer.addEventListener('wa-show', () => trigger.setAttribute('aria-expanded', 'true'));
    drawer.addEventListener('wa-hide', () => trigger.setAttribute('aria-expanded', 'false'));
    drawer.addEventListener('wa-after-hide', () => trigger.focus());
  }
</script>
