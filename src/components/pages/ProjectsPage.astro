---
import type { Locale } from '../../consts';
import { getSiteCopy } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const projects = [...copy.projects].sort((left, right) => Number(left.number) - Number(right.number));
---

<BaseLayout
  locale={locale}
  title={copy.meta.projectsTitle}
  description={copy.projectsPage.intro}
  alternatePath={locale === 'en' ? '/zh/projects/' : '/projects/'}
>
  <header class="projects-page-header" id="top">
    <p class="eyebrow">{copy.projectsPage.title}</p>
    <h1>{locale === 'zh' ? '做过的事' : 'Selected work'}</h1>
    <p>{copy.projectsPage.intro}</p>
  </header>

  <section class="projects-page-grid" aria-label={copy.projectsPage.title}>
    {projects.map((project) => (
      <a class="projects-page-card" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} — ${copy.projectsPage.githubCta}`}>
        <div class="projects-page-card-topline">
          <span>{project.number} / {project.type}</span>
          <span>{project.href.includes('github.com') ? copy.projectsPage.sourceLabel : locale === 'zh' ? '项目网站' : 'Project site'}</span>
        </div>
        <div class="projects-page-card-title">
          <span class="projects-page-card-mark" aria-hidden="true">{project.number}</span>
          <div>
            <h2>{project.title}</h2>
            <p>{project.summary}</p>
          </div>
        </div>
        <div class="projects-page-card-details">
          <ul class="projects-page-highlights" aria-label={copy.projectsPage.highlightsLabel}>
            {project.proof.slice(0, 2).map((highlight) => <li>{highlight}</li>)}
          </ul>
          <ul class="projects-page-tags" aria-label={copy.projectsPage.stackLabel}>
            {project.stack.slice(0, 3).map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <span class="projects-page-cta">{project.href.includes('github.com') ? copy.projectsPage.githubCta : copy.projectsPage.siteCta} <i aria-hidden="true">↗</i></span>
      </a>
    ))}
  </section>
</BaseLayout>
