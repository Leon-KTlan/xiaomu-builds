---
import type { Locale } from '../../consts';
import { getSiteCopy } from '../../data/site';
import ArchitecturePanel from '../ArchitecturePanel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const prefix = locale === 'zh' ? '/zh' : '';
---

<BaseLayout
  locale={locale}
  title={copy.meta.caseTitle}
  description={copy.flagship.subtitle}
  type="article"
  alternatePath={locale === 'en' ? '/zh/projects/reviewable-runtime/' : '/projects/reviewable-runtime/'}
>
  <article class="case-study" id="top">
    <header class="case-hero">
      <a class="back-link eyebrow" href={`${prefix}/projects/`}>← {copy.casePage.back}</a>
      <p class="case-marker">{copy.flagship.marker}</p>
      <h1>{copy.flagship.title}</h1>
      <p class="case-deck">{copy.flagship.subtitle}</p>
      <div class="case-meta">
        <span>ROLE</span><p>{copy.flagship.role}</p>
        <span>SCOPE</span><p>{copy.flagship.boundary}</p>
      </div>
    </header>

    <section class="case-section split">
      <div class="case-section-label"><span>01</span><p>{copy.casePage.situation}</p></div>
      <div class="case-prose"><p class="case-lead">{copy.casePage.situationBody}</p></div>
    </section>

    <section class="case-section architecture-case">
      <div class="case-section-label"><span>02</span><p>{copy.flagship.architectureTitle}</p></div>
      <ArchitecturePanel locale={locale} />
    </section>

    <section class="case-section">
      <div class="case-section-label"><span>03</span><p>{copy.casePage.principles}</p></div>
      <div class="decision-grid">
        {copy.casePage.decisions.map((decision) => (
          <article>
            <span>{decision.number}</span>
            <h2>{decision.title}</h2>
            <p>{decision.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="case-section evaluation-case">
      <div class="case-section-label"><span>04</span><p>{copy.casePage.evaluationTitle}</p></div>
      <div>
        <p class="case-lead">{copy.casePage.evaluationBody}</p>
        <div class="metric-grid">
          {copy.flagship.metrics.map((metric) => (
            <div class="metric">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
              <small>{metric.detail}</small>
            </div>
          ))}
        </div>
        <p class="caveat"><span>!</span>{copy.flagship.caveat}</p>
      </div>
    </section>

    <section class="case-section split">
      <div class="case-section-label"><span>05</span><p>{copy.casePage.scopeTitle}</p></div>
      <div class="case-prose"><p>{copy.casePage.scopeBody}</p></div>
    </section>

    <footer class="case-ending">
      <p>{copy.casePage.endTitle}</p>
      <blockquote>{copy.casePage.endQuote}</blockquote>
    </footer>
  </article>
</BaseLayout>
