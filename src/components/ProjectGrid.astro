---
import type { Locale } from '../consts';
import { getSiteCopy } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const projects = [...copy.projects].sort((left, right) => Number(left.number) - Number(right.number));
---

<div class="project-grid">
  {projects.map((project) => (
    <article class="project-card">
      <a href={project.href} target="_blank" rel="noopener" aria-label={`${project.title} — ${project.href.includes('github.com') ? 'GitHub' : locale === 'zh' ? '项目网站' : 'Project website'}`}>
        <div class="project-card-topline">
          <span>{project.number}</span>
          <span>{project.type}</span>
          <span aria-hidden="true">↗</span>
        </div>
        <div class="project-card-title">
          <span class="project-card-mark" aria-hidden="true">{project.number}</span>
          <div>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
          </div>
        </div>
        <ul class="tag-list" aria-label={locale === 'zh' ? '技术栈' : 'Technology stack'}>
          {project.stack.slice(0, 3).map((item) => <li>{item}</li>)}
        </ul>
        <span class="project-card-cta">{locale === 'zh' ? '查看项目' : 'View project'} <i aria-hidden="true">↗</i></span>
      </a>
    </article>
  ))}
</div>
