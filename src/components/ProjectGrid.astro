---
import type { Locale } from '../consts';
import { getSiteCopy } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
---

<div class="project-grid">
  {copy.projects.map((project) => (
    <article class="project-card">
      <a href={project.href} target="_blank" rel="noopener" aria-label={`${project.title} — GitHub`}>
        <div class="project-card-topline">
          <span>{project.number}</span>
          <span>{project.type}</span>
          <span aria-hidden="true">↗</span>
        </div>
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <ul class="proof-list" aria-label={locale === 'zh' ? '项目证据' : 'Project evidence'}>
          {project.proof.map((item) => <li>{item}</li>)}
        </ul>
        <ul class="tag-list" aria-label={locale === 'zh' ? '技术栈' : 'Technology stack'}>
          {project.stack.map((item) => <li>{item}</li>)}
        </ul>
      </a>
    </article>
  ))}
</div>
